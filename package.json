{
  "name": "geo-picker",
  "displayName": "Geo Picker",
  "description": "Pick and insert lat/long coordinates from a map",
  "version": "1.0.0",
  "publisher": "corcordan",
  "repository": "https://github.com/corcordan/geo-picker",
  "bugs": "https://github.com/corcordan/geo-picker/issues",
  "engines": {
    "vscode": "^1.109.0"
  },
  "activationEvents": [
    "onCommand:geoPicker.pickCoordinate"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "geoPicker.pickCoordinate",
        "title": "Add Coordinate"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "geoPicker.pickCoordinate",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
